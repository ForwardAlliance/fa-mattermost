# MATTERMOST_IMAGE is appended by cloudbuild.mattermost.yaml at deploy time and must
# not be stored here. MATTERMOST_VERSION is a Cloud Build substitution now that the
# image is built in the pipeline instead of on the VM.
MM_DATASOURCE=postgres://mattermost:password@/mattermost?host=/cloudsql/PROJECT_ID:REGION:INSTANCE
MM_SITE_URL=https://chat.example.com
# Set to false to stop Mattermost sending email or push.
MM_SEND_EMAIL_NOTIFICATIONS=true
MM_SEND_PUSH_NOTIFICATIONS=true
# Password-reset host for this environment.
MM_FORGOT_PASSWORD_LINK=https://account.example.com/mattermost/password
# The app download host for THIS environment.
MM_APP_DOWNLOAD_LINK=https://app.example.com
# Both default to false. Set to true only for the first deploy against an empty
# database, so the first user can self-register and become system admin, then
# remove them and deploy again.
# MM_ENABLE_USER_CREATION=true
# MM_ENABLE_SIGNUP_WITH_EMAIL=true
# Space-separated web origins allowed to embed Mattermost in an iframe and call its API (CORS + CSP frame-ancestors). Set per environment, e.g. https://manual.forward.org.tw for prod, https://manual.icanhelp.tw for preview.
MM_WEB_ORIGINS=https://manual.example.com
MM_FILESETTINGS_DRIVERNAME=amazons3
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=REPLACE_WITH_GCS_HMAC_ACCESS_KEY
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=REPLACE_WITH_GCS_HMAC_SECRET
MM_FILESETTINGS_AMAZONS3BUCKET=REPLACE_WITH_GCS_BUCKET
MM_FILESETTINGS_AMAZONS3PATHPREFIX=
MM_FILESETTINGS_AMAZONS3REGION=
MM_FILESETTINGS_AMAZONS3ENDPOINT=storage.googleapis.com
MM_FILESETTINGS_AMAZONS3SSL=true
MM_FILESETTINGS_AMAZONS3SIGNV2=false
CLOUDSQL_INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE
CLOUDFLARE_TUNNEL_TOKEN=replace-me

MM_EMAILSETTINGS_SMTPPASSWORD=your-password

MM_PUSH_NOTIFICATION_SERVER=https://account.forward.org.tw/v1/mattermost-push/REPLACE_WITH_INTRA_SERVICE_KEY
